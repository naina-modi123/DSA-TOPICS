class Solution {
    public int minAddToMakeValid(String s) {
        int countOpen = 0;
        int countClosed = 0;
        for(char ch : s.toCharArray()){
            if(ch == '('){
                countOpen++;
            }else{
                if(countOpen > 0){
                    countOpen--;
                }else{
                    countClosed++;
                }
            }
        }
        return countOpen + countClosed;
        
    }
}
