class Solution {
    public int maxProduct(int n) {
        List<Integer> list = new ArrayList<>();
        while(n > 0){
            int digit = n%10;
            list.add(digit);
            n /= 10;
        }
        int sze = list.size();
        int prod = 1;
        int maxProd = Integer.MIN_VALUE;
        for(int i=0;i<sze;i++){
            for(int j=i+1;j<sze;j++){
                prod = list.get(i)*list.get(j);
                maxProd = Math.max(maxProd, prod);
            }
        }
        return maxProd;
        
    }
}
