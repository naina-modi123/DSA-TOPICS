class Solution {
    public int[] findRightInterval(int[][] intervals) {
        int n = intervals.length;
        int[] ans = new int[n];
        int[][] starts = new int[n][2];
        for(int i=0;i<n;i++){
            starts[i][0] = intervals[i][0];
            starts[i][1] = i;
        }
        Arrays.sort(starts, (a,b) -> Integer.compare(a[0], b[0]));
        for(int i=0;i<n;i++){
            int end = intervals[i][1];
            int low = 0, high = n-1;
            int pos = -1;

            while(low <= high){
                int mid = low +(high - low)/2;
                if(starts[mid][0] >= end){
                    pos = mid;
                    high = mid - 1;
                }else{
                    low = mid + 1;
                }
            }
            if(pos != -1){
                ans[i] = starts[pos][1];
            }else{
                ans[i] = -1;
            }
        }
        return ans;
    }
}
