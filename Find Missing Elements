class Solution {
    public List<Integer> findMissingElements(int[] nums) {
        int n = nums.length;
        Arrays.sort(nums);
        List<Integer> ans = new ArrayList<>();
        int target = nums[0]+1;
        for(int i=1;i<n;i++){
            int prev = nums[i-1];
            int curr = nums[i];
            while(prev+1 < curr){
                ans.add(prev+1);
                prev++;
            }
        }
        return ans;

        
    }
}
