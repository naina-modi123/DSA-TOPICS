class Solution {
    public int minOperations(int[] nums, int k) {
        int n = nums.length;
        int opr = 0;
        for(int num : nums){
            if(num < k){
                opr++;
            }
        }
        return opr;
    }
}
//or
class Solution {
    public int minOperations(int[] nums, int k) {
        int n = nums.length;
        Arrays.sort(nums);
        int low = 0;
        int high = n-1;
        while(low <= high){
            int mid = low+(high-low)/2;
            if(nums[mid] >= k){
                high = mid-1;
            }else{
                low = mid+1;
            }
        }
        return low;
    }
}
