class Solution {
    public int minOperations(int[] nums, int x) {
        int n = nums.length;
        int k = -x;
        for(int num : nums){
            k += num;
        }
        if(k < 0) return -1;
        if(k == 0) return n;

        int best = -1, i=0, sum = 0;
        for(int j=0;j<n;j++){
            sum += nums[j];
            while(sum > k){
                sum -= nums[i++];
            }
            if(sum == k){
                best = Math.max(best, j-i+1);
            }
        }
        return best < 0 ? -1 :n- best;
    }
}
