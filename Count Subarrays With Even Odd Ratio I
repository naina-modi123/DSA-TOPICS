class Solution {
    public int countRatioSubarrays(int[] nums, int a, int b) {
        int n = nums.length;
        int ans = 0;

        for (int i = 0; i < n; i++) {

            int oddC = 0;
            int evenC = 0;

            for (int j = i; j < n; j++) {

                if (nums[j] % 2 == 0)
                    evenC++;
                else
                    oddC++;

                if (oddC > 0 && (long) evenC * b <= (long) a * oddC)
                    ans++;
            }
        }

        return ans;
        
    }
}
