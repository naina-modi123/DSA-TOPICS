class Solution {
    public String reversePrefix(String word, char ch) {
        StringBuilder sb = new StringBuilder();
        Stack<Character> st = new Stack<>();
        int i = 0;
        while(i < word.length()){
            st.push(word.charAt(i));
            if(word.charAt(i) == ch){
                while(!st.isEmpty()){
                    sb.append(st.pop());
                }
                i++;

                while(i < word.length()){
                    sb.append(word.charAt(i));
                    i++;
                }
                return sb.toString();
            }
            i++;
        }
        return word;
    }
}
