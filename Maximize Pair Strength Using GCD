class Solution {
    private int gcd(int a, int b){
        while(b != 0){
            int temp = a%b;
            a = b;
            b = temp;
        }
        return a;
    }
    public long maxPairStrength(int[] nums) {
        int n = nums.length;
        long maxStrength = Long.MIN_VALUE;
        for(int i=0;i<n;i++){
            for(int j=i+1;j<n;j++){
                long g = gcd(nums[i], nums[j]);
long strength = (1L * nums[i] * nums[j]) / (g * g);
                maxStrength = Math.max(maxStrength, strength);
            }
        }
        return maxStrength;
        
    }
}
