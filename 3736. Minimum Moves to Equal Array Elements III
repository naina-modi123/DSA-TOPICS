class Solution {
    public int minMoves(int[] nums) {
        int n = nums.length;
        int maximum = Integer.MIN_VALUE;
        for(int num : nums){
            if(num > maximum){
                maximum = num;
            }
        }
        int ans = 0;
        for(int num : nums){
            ans += Math.abs(maximum - num);
        }
        return ans;
    }
}
